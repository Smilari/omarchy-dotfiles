{
  "bar": {
    "background": "none",
    "layout": {
      "center": [
        {
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "cities": [
            {
              "name": "Buenos Aires",
              "zone": "America/Argentina/Buenos_Aires"
            },
            {
              "name": "London",
              "zone": "Europe/London"
            },
            {
              "name": "Dubai",
              "zone": "Asia/Dubai"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            }
          ],
          "id": "omarchy.elsewhen",
          "units": "C"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "cpu",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu",
          "interval": 3,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "memory",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/memory",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "cpu-temp",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/cpu-temp",
          "interval": 5,
          "onClick": "omarchy-launch-or-focus-tui btop"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "vpn",
          "type": "command",
          "exec": "~/.config/omarchy/bar/scripts/vpn-status",
          "interval": 5
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.monitor"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
