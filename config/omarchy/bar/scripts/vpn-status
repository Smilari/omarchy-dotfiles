#!/usr/bin/env bash
# Estado de la VPN Forti (openfortivpn -> interfaz ppp*). Salida JSON estilo Waybar.
iface=$(ip -o link show 2>/dev/null | grep -oP ': \Kppp\d+' | head -1)
if [[ -n $iface ]]; then
  ip=$(ip -4 -o addr show dev "$iface" 2>/dev/null | awk '{print $4}' | head -1)
  printf '{"text":"󰦝","tooltip":"VPN encendida (%s): %s","class":"active"}\n' "$iface" "${ip:-sin IP}"
else
  printf '{"text":"󰦞","tooltip":"VPN apagada","class":"inactive"}\n'
fi
